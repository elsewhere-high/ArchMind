{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archmind.local/schemas/run-state-v0.1.schema.json",
  "title": "ArchMind Run State v0.1",
  "type": "object",
  "required": [
    "run_id",
    "task_id",
    "status",
    "updated_at",
    "updated_by",
    "human_gate_closed",
    "unprocessed_human_required_items",
    "history"
  ],
  "properties": {
    "run_id": {"const": "run-002-human-gate"},
    "task_id": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": [
        "CREATED",
        "RUNNING",
        "PROFESSIONAL_REVIEW",
        "CROSS_DISCIPLINE_REVIEW",
        "EVIDENCE_VERIFYING",
        "WAITING_HUMAN",
        "RESUMED",
        "BLOCKED_FOR_EVIDENCE",
        "RERUN_REQUIRED",
        "REVIEW_REJECTED",
        "COMPLETED"
      ]
    },
    "updated_at": {"type": "string", "format": "date-time"},
    "updated_by": {"type": "string", "minLength": 1},
    "human_gate_closed": {"type": "boolean"},
    "unprocessed_human_required_items": {"type": "integer", "minimum": 0},
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event_id", "from", "to", "at", "actor", "evidence_ref"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "from": {"type": ["string", "null"]},
          "to": {"type": "string", "minLength": 1},
          "at": {"type": "string", "format": "date-time"},
          "actor": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "completed_at": {"type": "string", "format": "date-time"},
    "completed_by": {"type": "string", "minLength": 1},
    "final_summary_ref": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "COMPLETED"}}},
      "then": {
        "required": ["completed_at", "completed_by", "final_summary_ref"],
        "properties": {
          "human_gate_closed": {"const": true},
          "unprocessed_human_required_items": {"const": 0}
        }
      }
    },
    {
      "if": {"properties": {"unprocessed_human_required_items": {"minimum": 1}}},
      "then": {"not": {"properties": {"status": {"const": "COMPLETED"}}}}
    }
  ],
  "additionalProperties": false
}
